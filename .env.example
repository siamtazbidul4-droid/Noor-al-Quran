# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# Production: Set to your actual domain (e.g., https://noor-al-quran.render.com)
# Development: Leave empty to allow any origin
APP_URL="MY_APP_URL"

# Server & Database Configuration
PORT=3000
NODE_ENV="development"
SESSION_SECRET="your-session-secret-change-in-production"

# MongoDB: Connection string for persistent account bookmarks, history, and preferences
# Example: mongodb://localhost:27017/noor-al-quran or mongodb+srv://...
# REQUIRED for production authentication. If not set, registration and login will be disabled in production.
MONGODB_URI=""

# ALLOW_DEMO_LOGIN: Set to "true" ONLY for development/testing to enable demo login without MongoDB.
# When false (default), production deployments without MONGODB_URI will reject login attempts.
# NEVER set to "true" in production. This is a security control.
ALLOW_DEMO_LOGIN="false"
